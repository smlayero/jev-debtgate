{
  "name": "jev-debtgate",
  "version": "0.3.0",
  "description": "Jev-powered technical debt gate for coding agents and CI. Collects git/file metrics locally, asks TypeSafe Jev typed questions, then applies confidence policy.",
  "type": "module",
  "bin": {
    "jev-debtgate": "./dist/cli.js",
    "debtgate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "templates",
    "action.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    ".env.example",
    ".debtgate.json.example",
    ".cursor/mcp.json.example",
    "scripts/prepare.mjs"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js && node scripts/check-secrets.mjs",
    "live": "node scripts/live-e2e.mjs",
    "mcp": "node dist/mcp.js",
    "debtgate": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-scala": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.45.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "jev",
    "typesafe",
    "technical-debt",
    "mcp",
    "cursor",
    "ci",
    "ast",
    "static-analysis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/smlayero/jev-debtgate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smlayero/jev-debtgate.git"
  },
  "bugs": {
    "url": "https://github.com/smlayero/jev-debtgate/issues"
  }
}
