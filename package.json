{
  "name": "jev-debtgate",
  "version": "0.1.0",
  "description": "Jev-powered technical debt gate for coding agents and CI. Collects git/file metrics locally, asks TypeSafe Jev typed questions, then applies confidence policy.",
  "type": "module",
  "bin": {
    "jev-debtgate": "./dist/cli.js",
    "debtgate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "action.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js && node scripts/check-secrets.mjs",
    "live": "node scripts/live-e2e.mjs",
    "mcp": "node dist/mcp.js",
    "debtgate": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "jev",
    "typesafe",
    "technical-debt",
    "mcp",
    "cursor",
    "ci"
  ],
  "license": "MIT",
  "homepage": "https://github.com/smlayero/jev-debtgate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smlayero/jev-debtgate.git"
  },
  "bugs": {
    "url": "https://github.com/smlayero/jev-debtgate/issues"
  }
}
